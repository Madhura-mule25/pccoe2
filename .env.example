# Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# Google Gemini AI API Key
# Get it from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeather API Key
# Get it from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Data.gov.in API Key (Optional)
DATAGOVIN_API_KEY=your_datagovin_api_key_here

# CEDA (Ashoka University) Agmarknet API Key
# Get it from: https://ceda.ashoka.edu.in
CEDA_API_KEY=your_ceda_api_key_here

# Optional: Default Language (en, hi, mr)
LANGUAGE=en
